[Unit]
Description=IndiaMART CRM FastAPI Backend & WhatsApp AI Bot
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/indiamart-crm
ExecStart=/var/www/indiamart-crm/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
Environment=PORT=8000
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
